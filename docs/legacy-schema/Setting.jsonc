{
  "name": "Setting",
  "type": "object",
  "properties": {
    "restaurant_name": {
      "type": "string",
      "default": "Nanay Asa Restaurant"
    },
    "logo_url": {
      "type": "string"
    },
    "banner_image_url": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "business_hours": {
      "type": "string"
    },
    "currency_symbol": {
      "type": "string",
      "default": "\u20b1"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "receipt_footer": {
      "type": "string"
    },
    "enable_dinein": {
      "type": "boolean",
      "default": true
    },
    "enable_takeout": {
      "type": "boolean",
      "default": true
    },
    "enable_delivery": {
      "type": "boolean",
      "default": true
    },
    "min_order": {
      "type": "number",
      "default": 0
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "prep_time_minutes": {
      "type": "number",
      "default": 30
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 0
    },
    "deduct_on_status": {
      "type": "string",
      "default": "Completed"
    },
    "receipt_width": {
      "type": "string",
      "default": "80mm"
    },
    "receipt_copies": {
      "type": "number",
      "default": 1
    },
    "receipt_auto_print": {
      "type": "boolean",
      "default": false
    },
    "receipt_show_logo": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_customer": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_vat": {
      "type": "boolean",
      "default": true
    },
    "receipt_header": {
      "type": "string"
    },
    "coming_soon_enabled": {
      "type": "boolean",
      "default": false
    },
    "coming_soon_title": {
      "type": "string",
      "default": "Coming Soon"
    },
    "coming_soon_message": {
      "type": "string",
      "default": "We are working on something amazing. Stay tuned!"
    },
    "coming_soon_background_url": {
      "type": "string"
    }
  },
  "required": []
}