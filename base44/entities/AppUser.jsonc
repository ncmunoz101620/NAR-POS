{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "role_name": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "enum": [
        "All",
        "NAR Commi",
        "NAR Greenwoods"
      ]
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_login": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email"
  ]
}